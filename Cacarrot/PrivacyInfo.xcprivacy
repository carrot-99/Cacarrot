<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 広告目的のトラッキングはしない（Firebase は広告IDを使わない FirebaseAnalyticsWithoutAdIdSupport を組み込み、AdSupport・ATT にリンクしていない） -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  収集するデータ：Firebase Analytics（GoogleAppMeasurement 10.23 は独自の
	  プライバシーマニフェストを含まないため、アプリ側で宣言する）
	  - アプリインスタンスID（デバイスID相当）
	  - 製品の操作（画面表示・セッションなどの自動収集イベント）
	  いずれもユーザーの身元には結び付けず、トラッキングにも使わない。分析目的のみ。
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>

	<!-- 理由の申告が必要な API -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults：おすすめ順・ジャンル絞り込み・初回ガイドの設定を、このアプリ内だけで保存・読み込み -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
